# Telegram Bot Configuration
# Obtain your bot token from @BotFather on Telegram (https://t.me/BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Admin Telegram User ID (optional, allows using /broadcast, /announce_scores, /stats)
# Get your numeric ID from @userinfobot on Telegram
ADMIN_USER_ID=

# Admin Public Contact Handle / Link (shown in Contact Support button)
ADMIN_CONTACT=@mx767

# Server Port for Render / Hosting health check
PORT=8080

# Timezone for alert scheduling (default: Asia/Tashkent, Uzbekistan)
TIMEZONE=Asia/Tashkent

# Optional Database Persistence (PostgreSQL / Supabase connection string)
# If provided, subscriber data is permanently stored in PostgreSQL across deploys
# DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# Optional SQLite Database Path (auto-detects Render persistent disk at /var/data if mounted)
# DB_PATH=/var/data/sat_bot.db
