# Telegram Bot Configuration
# Obtain your bot token from @BotFather on Telegram (https://t.me/BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Admin Telegram User ID (optional, allows using /broadcast, /announce_scores, /stats)
# Get your numeric ID from @userinfobot on Telegram
ADMIN_USER_ID=

# Admin Public Contact Handle / Link (shown in Contact Support button)
ADMIN_CONTACT=@mx767

# Server Port for Render / Hosting health check
PORT=8080

# Timezone for alert scheduling (default: US/Eastern, College Board release timezone)
TIMEZONE=US/Eastern
